{
  "name": "project-thesis-rewriter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sentence-level academic writing platform for thesis rewriting",
  "main": "app.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon app.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node app.js",
    "preview": "vite preview",
    "db:seed": "node scripts/db/seed.cjs",
    "import:upload": "node scripts/process-upload.cjs",
    "temp-test": "node scripts/temp-test.cjs",
    "fixtures:generate": "node scripts/generate-test-fixtures.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UTSC-CSCC09-Programming-on-the-Web/project-thesis-rewriter.git"
  },
  "license": "ISC",
  "dependencies": {
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-font-family": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.3"
  }
}
