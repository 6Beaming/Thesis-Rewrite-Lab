# Public URL where the browser reaches the app. Do not add a trailing slash.
APP_ORIGIN=http://localhost:5173

# Local PostgreSQL started by `npm run db:up`.
DATABASE_URL=postgresql://thesis_rewriter:thesis_rewriter_dev@localhost:5432/thesis_rewriter

# Required Google "Web application" OAuth credentials.
# Keep real values in .env locally and in deployment secrets in production.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Required in production. Generate at least 32 random bytes and inject it through
# the deployment environment; never commit its value.
AUTH_SECRET=

# Server-only OpenAI configuration. Never expose it with a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_REWRITE_MODEL=gpt-5.4-mini
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_PRACTICE_MODEL=gpt-5.4-mini
# Embeddings are designed for clustering, similarity, classification, and search
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional but recommended identification for the Crossref polite API pool.
# Crossref lookups do not require an API key.
CROSSREF_CONTACT_EMAIL=
CROSSREF_TIMEOUT_MS=5000

# Upload preprocessing mode: semantic uses local winkNLP similarity; character
# uses sentence-aware character balancing only.
DOCUMENT_PARTITION_MODE=semantic

