# Public URL where the browser reaches the app. Do not add a trailing slash.
APP_ORIGIN=http://localhost:5173

# Production process settings. Development commands already provide their own
# ports and mode.
# NODE_ENV=production
# PORT=3001
# TRUST_PROXY_HOPS=1

# Production image references are consumed by compose.production.yaml. CI
# should replace the tags with commit-specific tags or immutable digests.
# APP_IMAGE_REF=ghcr.io/utsc-cscc09-programming-on-the-web/project-thesis-rewriter:<commit-sha>
# NLP_IMAGE_REF=ghcr.io/utsc-cscc09-programming-on-the-web/project-thesis-rewriter-nlp:<commit-sha>

# Local PostgreSQL started by `npm run db:up`.
DATABASE_URL=postgresql://thesis_rewriter:thesis_rewriter_dev@localhost:5432/thesis_rewriter

# Production Compose initializes PostgreSQL from these values. Use a strong,
# unique password and URL-encode it when placing it in DATABASE_URL.
# POSTGRES_DB=thesis_rewriter
# POSTGRES_USER=thesis_rewriter
# POSTGRES_PASSWORD=

# Required Google "Web application" OAuth credentials.
# Keep real values in .env locally and in deployment secrets in production.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Required in production. Generate at least 32 random bytes and inject it through
# the deployment environment; never commit its value.
AUTH_SECRET=

# Server-only Stripe configuration. STRIPE_WEBHOOK_SECRET must belong to the
# registered endpoint for the active environment, not an unrelated CLI
# listener. STRIPE_PUBLISHABLE_KEY is currently unused by hosted Checkout.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID=
STRIPE_PRICE_ID=

# Server-only OpenAI configuration. Never expose it with a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_REWRITE_MODEL=gpt-5.4-mini
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_PRACTICE_MODEL=gpt-5.4-mini
# Embeddings are designed for clustering, similarity, classification, and search
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional but recommended identification for the Crossref polite API pool.
# Crossref lookups do not require an API key.
# CROSSREF_CONTACT_EMAIL=
# CROSSREF_TIMEOUT_MS=5000

# Upload preprocessing mode: semantic uses local winkNLP similarity; character
# uses sentence-aware character balancing only.
DOCUMENT_PARTITION_MODE=semantic

# NLP service and staged feature rollout
NLP_SERVICE_URL=http://127.0.0.1:8081
NLP_SERVICE_ENABLED=true
NLP_UPLOAD_PARTITION_ENABLED=true
NLP_LIVE_BLOCK_CHECK_ENABLED=true
NLP_REWRITE_GATE_ENABLED=true
NLP_ANALYZING_FLIP_CARD_ENABLED=true
NLP_SEMANTIC_PROFILE_ENABLED=true
NLP_REPARTITION_ENABLED=true
MCP_CITATION_V2_ENABLED=true
NLP_FAIL_OPEN=true
NLP_BLOCK_TIMEOUT_MS=8000
NLP_PARTITION_TIMEOUT_MS=45000
NLP_HEALTH_TIMEOUT_MS=1500
NLP_JOB_CONCURRENCY=1

# Optional production container resource limits.
# NLP_MEMORY_LIMIT=2g
# NLP_CPU_LIMIT=2.0

# The Python image downloads this pinned model during its build.
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTENCE_TRANSFORMER_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
